# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

# Conexão com o PostgreSQL local, usando o usuário dedicado criado em db/create-role.sql.
# Se a senha tiver @ # / : ou ?, esses caracteres precisam ser codificados na URL (ex.: @ vira %40).
DATABASE_URL=postgres://budget_app:SUA_SENHA_AQUI@localhost:5432/personal_budget

# Porta do servidor (opcional; padrão 3000).
PORT=3000
